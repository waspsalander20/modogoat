// Prisma schema — Modo GOAT
// Ver GDD § 3 (Base de Datos). Alcance recortado a lo que pide § "Prioridades para el demo":
// sin auth compleja, sin mentores/medallas persistidos aparte (se calculan en el motor).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Programa representa un cliente institucional (colegio, gobierno) que
// despliega el juego — hoy solo país + nombre, deliberadamente mínimo. Ver
// la auditoría del motor (sección 14) para la arquitectura de capas
// completa: Programa/Vertical/Partner quedan diferidas hasta que haya
// evidencia real de necesitarlas, no se construyen especulativamente.
model Programa {
  id                 String    @id @default(cuid())
  slug               String    @unique
  nombre             String
  pais               String
  // Cuántas partidas le corresponden a cada jugador de este programa antes
  // de que su informe comparativo se considere "completo" (ver
  // lib/data/paquete.ts). Null = usa el default global (3). Variable porque
  // un cliente institucional futuro podría pedir un paquete distinto.
  partidasPorPaquete Int?
  createdAt          DateTime  @default(now())
  jugadores          Jugador[]
}

model Jugador {
  id     String @id @default(cuid())
  nombre String

  // Cuenta — email/contraseña se piden al registrarse, ANTES de que exista
  // cualquier partida. edad/genero/contexto/trabaja en cambio se piden en el
  // onboarding de la primera partida, por eso son opcionales acá: quedan en
  // null entre el registro y ese primer onboarding, y de ahí en adelante
  // siempre están set (toda partida requiere haber pasado por onboarding).
  email                  String?   @unique
  passwordHash           String?
  // Arranca en false — el jugador queda pendiente de activación manual
  // desde el dashboard (piloto con colegios: solo se activan cuentas de
  // alumnos con consentimiento ya verificado por la institución).
  activo                 Boolean   @default(false)
  // Confirmación de correo (Resend) — informativa por ahora, no bloquea el
  // login (ese gate ya lo cumple "activo"). Sirve para saber si el jugador
  // realmente es dueño del correo que puso.
  emailConfirmado        Boolean   @default(false)
  emailConfirmacionToken String?   @unique
  // Recuperar contraseña — token de un solo uso con expiración corta.
  resetPasswordToken     String?   @unique
  resetPasswordExpira    DateTime?
  edad                   Int?
  genero                 String?
  ciudad                 String    @default("Medellín")
  // País del jugador — vive acá (no solo en Programa) porque a futuro habrá
  // jugadores directos sin ningún programa institucional de por medio (ej.
  // un padre que compra el juego para su hijo). Programa.pais solo
  // pre-llena este campo cuando el jugador entra desde un link institucional.
  pais                   String    @default("CO")
  contexto               String?
  trabaja                String?
  programaId             String?
  programa               Programa? @relation(fields: [programaId], references: [id])
  createdAt              DateTime  @default(now())
  partidas               Partida[]
}

model Partida {
  id        String  @id @default(cuid())
  jugadorId String
  jugador   Jugador @relation(fields: [jugadorId], references: [id])

  // Onboarding
  respuestasOnboarding Json
  tiemposOnboarding    Json
  areaLibre            String?
  rutaEntrada          String?

  // Perfil calculado
  puntosPerfil     Json
  perfilDominante  String?
  perfilSecundario String?
  esMixto          Boolean @default(false)
  bigFive          Json?

  // Estado del juego
  edadInicio     Int
  edadActual     Int     @default(0)
  ingresoActual  Int     @default(0)
  ahorros        Int     @default(0)
  skills         Json    @default("{}")
  aniosJugados   Int     @default(0)
  aniosEstancado Int     @default(0)
  mentorActivo   String?
  estado         String  @default("onboarding") // onboarding | jugando | terminado
  // Cuántas veces ya apareció La Cabrita (amiga/mascota, distinta de los
  // mentores profesionales — ver regla 7b en aiMotor.ts) reflexionando sobre
  // priorizar plata sobre salud/familia. Tope de 3 por partida para que no
  // se sienta como un sermón — se enforce en código, no solo en el prompt.
  vecesCabrita   Int     @default(0)

  // Resultado
  resultadoTipo   String?
  ingresoFinal    Int?
  skillsFinales   Json?
  medallasGanadas String[] @default([])
  alertas         String[] @default([])
  // Respuesta a la reflexión final (¿te sientes conforme/feliz con tu
  // camino?) — solo se pregunta si el ingreso ya cruzó el umbral económico
  // de GOAT; null significa "no se le preguntó" (nunca calificó, o la
  // partida terminó antes de esta versión). El GOAT exige feliz === true,
  // no solo el ingreso (ver determinarResultado en lib/motor.ts).
  felizFinal      Boolean?

  // Anti-troll
  tiempoPromedio Float?
  patronTroll    Boolean @default(false)

  // Motor narrativo con IA (ver ModoGOAT_Prompt_Motor.md): decisión o evento
  // generado y pendiente de respuesta, para no regenerar contenido distinto
  // en cada recarga de pantalla.
  turnoActual   Json?
  analisisFinal String?

  // Costo real de IA acumulado de esta partida (para el dashboard de
  // Sapiencia — costo real por ahora, luego se multiplica para el precio).
  tokensInput      Int @default(0)
  tokensOutput     Int @default(0)
  tokensCacheWrite Int @default(0)
  tokensCacheRead  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisiones DecisionJugada[]
  eventos    EventoJugado[]

  @@index([perfilDominante])
  @@index([estado])
}

model DecisionJugada {
  id        String  @id @default(cuid())
  partidaId String
  partida   Partida @relation(fields: [partidaId], references: [id])

  anio            Int
  decisionId      String
  titulo          String  @default("")
  opcionElegida   String
  opcionTexto     String  @default("")
  campoLibre      String?
  tiempoRespuesta Float
  narrativa       String?

  ingresoAntes        Int
  ingresoDespues      Int
  skillsSubidas       Json
  puntosSumados       Json
  medallaDesbloqueada String?
  costoOportunidad    String?
  cabritaReflexion    String?

  createdAt DateTime @default(now())
}

model EventoJugado {
  id        String  @id @default(cuid())
  partidaId String
  partida   Partida @relation(fields: [partidaId], references: [id])

  anio            Int
  tipoEvento      String // imprevisto | oportunidad
  eventoId        String
  nombre          String  @default("")
  opcionElegida   String
  opcionTexto     String  @default("")
  tiempoRespuesta Float
  narrativa       String?

  ingresoAntes        Int?
  ingresoDespues      Int?
  skillsSubidas       Json    @default("{}")
  medallaDesbloqueada String?
  costoOportunidad    String?
  cabritaReflexion    String?

  createdAt DateTime @default(now())
}
