# Copiar a .env y completar. En Railway, DATABASE_URL la provee el plugin de PostgreSQL.
DATABASE_URL="postgres://postgres:postgres@localhost:54329/modogoat?sslmode=disable"

# Password compartida para acceder a /dashboard (Sapiencia). Cambiar en producción.
DASHBOARD_PASSWORD="cambia-esta-clave"

# Firma la cookie de sesión de cuentas de jugador. Cambiar en producción.
JUGADOR_SESSION_SECRET="cambia-este-secreto-tambien"

# Clave de la API de Claude (console.anthropic.com) — el motor narrativo del
# juego la necesita para generar decisiones, eventos y el análisis final.
ANTHROPIC_API_KEY="sk-ant-..."

# Correos transaccionales vía Resend (resend.com) — requiere un dominio verificado.
# Sin esta key, la app sigue funcionando pero no envía correos de verdad (solo loguea).
RESEND_API_KEY=""
RESEND_FROM="Modo GOAT <no-responder@modogoat.io>"
NEXT_PUBLIC_APP_URL="http://localhost:3006"
